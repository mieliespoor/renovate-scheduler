root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go and go.mod/go.sum are tab indented by the Go toolchain.
[*.{go,mod,sum}]
indent_style = tab

[Makefile]
indent_style = tab

# Preserve trailing whitespace in Markdown (used for hard line breaks).
[*.md]
trim_trailing_whitespace = false
